# OpenAI，或任意兼容 OpenAI 协议的服务商（如 DeepSeek、Moonshot 等）
OPENAI_API_KEY=sk-xxx

# 可选：兼容 OpenAI 协议的服务商地址，例如
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 可选：MCP 服务器配置（JSON）。启用后智能体会自动加载其工具。
# 示例使用项目自带的 mcp_demo_server.py，command 建议写 venv 里的 python 绝对路径：
# MCP_SERVERS={"weather-demo": {"transport": "stdio", "command": "C:\\projects\\Blue-Ocean\\.venv\\Scripts\\python.exe", "args": ["mcp_demo_server.py"]}}
